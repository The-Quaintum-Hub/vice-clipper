# Copia este archivo como ~/vice/.env y protégelo:   cp .env.example .env && chmod 600 .env
# NUNCA lo subas a git (ya está en .gitignore). Todas las claves de acá son GRATIS y ninguna pide tarjeta.

# ── Obligatorio ──────────────────────────────────────────────────────────────
# Juez IA: decide qué momento sirve. https://console.groq.com/keys
GROQ_API_KEY=
# Bot de Telegram donde te llegan los clips para aprobar (✅/❌). Créalo con @BotFather.
# El chat id: escríbele /start a tu bot y abre https://api.telegram.org/bot<TOKEN>/getUpdates ("chat":{"id":...})
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Tus cuentas ("marcas"): nombre_que_quieras=@tu_usuario, separadas por coma. El usuario es el mismo en TikTok,
# YouTube e Instagram. Un clip va a UNA sola cuenta. Con una sola cuenta también funciona.
VICE_CUENTAS=cuenta_1=@tu_usuario_1,cuenta_2=@tu_usuario_2
# VICE_IDIOMA=en                 # idioma de títulos y subtítulos (en | es)

# ── Opcional ─────────────────────────────────────────────────────────────────
# Ojos del juez: Gemini MIRA el momento (imagen + audio), descarta lo que no se ve y desenfoca desnudez.
# https://aistudio.google.com/apikey  (sin clave, el juez solo lee lo que se dice)
GEMINI_API_KEY=
# VICE_GEMINI_MODEL=gemini-3-flash-preview,gemini-3.1-flash-lite
# Vistas de tus Shorts por la API oficial (Google Cloud > YouTube Data API v3 > clave)
YOUTUBE_API_KEY=
# Ejemplos de clips virales para el juez (Apify, plan gratis de US$5 por mes)
APIFY_TOKEN=
# VICE_APIFY_USD=5
# Ghost: publica en TikTok/YouTube/Instagram lo que apruebas, con un Chrome real donde iniciaste sesión.
# Necesita escritorio (no sirve en un servidor sin pantalla). 1 = encendido.
VICE_GHOST=0
# VICE_GHOST_REDES=youtube,instagram
# VICE_CUPO=2                     # publicaciones por cuenta y red por día

# ── Ajustes (los valores por defecto andan bien) ─────────────────────────────
# VICE_ENCODER=vaapi              # vaapi = Intel Quick Sync (3x más rápido); x264 = cualquier CPU
# VICE_WHISPER_ES=medium
# VICE_WHISPER_EN=small
# VICE_JUEZ_MIN=60                # nota mínima (0-100) para que un clip salga
# VICE_MAX_CLIPS=8                # clips por VOD
# VICE_VIVO_MAX=2                 # directos grabando a la vez
# VICE_VIVO_UMBRAL=3.0            # qué tan fuerte tiene que ser un pico en vivo
# VICE_GRABACION_HORAS=24         # cuánto se guarda cada directo grabado tras su pasada final
# VICE_DATA=~/vice-data           # dónde quedan la base de datos, los clips y las grabaciones
# VICE_LLM=gemma3:4b              # respaldo local con Ollama si Groq no responde (opcional)
